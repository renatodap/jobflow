    {
      "parameters": {
        "functionCode": "// Parse incoming content and prepare for platform adaptation\nconst content = items[0].json;\n\n// Base content structure\nconst baseContent = {\n  message: content.mainContent || '',\n  hashtags: content.hashtags || '',\n  keyPoints: content.keyPoints ? content.keyPoints.split(',').map(p => p.trim()) : [],\n  contentType: content.contentType || 'announcement',\n  mediaUrl: content.mediaUrl || null\n};\n\n// Platform-specific adaptations\nconst platforms = {\n  twitter: {\n    enabled: content.platforms?.twitter !== false,\n    charLimit: 280,\n    content: ''\n  },\n  linkedin: {\n    enabled: content.platforms?.linkedin !== false,\n    charLimit: 3000,\n    content: ''\n  },\n  facebook: {\n    enabled: content.platforms?.facebook !== false,\n    charLimit: 63206,\n    content: ''\n  },\n  instagram: {\n    enabled: content.platforms?.instagram !== false,\n    charLimit: 2200,\n    content: ''\n  },\n  tiktok: {\n    enabled: content.platforms?.tiktok !== false,\n    charLimit: 150,\n    content: ''\n  }\n};\n\n// Content type emojis and titles\nconst contentTitles = {\n  'announcement': '🚀 Exciting News!',\n  'tip': '💡 Pro Tip',\n  'story': '📖 Success Story',\n  'promotion': '🎁 Special Offer',\n  'engagement': '🤔 Question for You'\n};\n\nconst title = contentTitles[baseContent.contentType] || '📢 Update';\nconst keyPointsList = baseContent.keyPoints.map(p => `✅ ${p}`).join('\\n');\n\n// Adapt content for each platform\nif (platforms.twitter.enabled) {\n  platforms.twitter.content = `${baseContent.message}\\n\\n${baseContent.hashtags}`.slice(0, 280);\n}\n\nif (platforms.linkedin.enabled) {\n  platforms.linkedin.content = `${title}\\n\\n${baseContent.message}\\n\\n${keyPointsList}\\n\\n${baseContent.hashtags}\\n\\n💬 What are your thoughts?`;\n}\n\nif (platforms.facebook.enabled) {\n  platforms.facebook.content = `${title}\\n\\n${baseContent.message}\\n\\n${keyPointsList}\\n\\n${baseContent.hashtags}`;\n}\n\nif (platforms.instagram.enabled) {\n  platforms.instagram.content = `${baseContent.message}\\n.\\n.\\n.\\n${baseContent.hashtags}\\n\\n📲 Link in bio for more details!`;\n}\n\nif (platforms.tiktok.enabled) {\n  platforms.tiktok.content = `${baseContent.message.slice(0, 100)}... ${baseContent.hashtags}`;\n}\n\nreturn [\n  {\n    json: {\n      baseContent,\n      platforms,\n      timestamp: new Date().toISOString()\n    }\n  }\n];"
      },
